# =============================================================================
# Spond Multi-User Bot — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in the values. Never commit .env to git.

# --- Database ---
# Password for the PostgreSQL container. Must match DATABASE_URL below.
DB_PASSWORD=changeme_db_password

# Full async connection string used by the app.
# For Docker Compose: use 'db' as the host (matches the service name).
DATABASE_URL=postgresql+asyncpg://spond:changeme_db_password@db:5432/spond_bot

# --- Security ---
# Symmetric key used to encrypt stored Spond tokens and passwords.
# Generate once with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# !! Keep this secret. Losing it means stored credentials become unreadable. !!
FERNET_KEY=

# Bearer token used to authenticate all REST API requests.
# Generate a strong random string, e.g.: openssl rand -hex 32
API_KEY=changeme_api_key

# --- Scheduler ---
# How often the discovery worker syncs events from Spond (in minutes).
DISCOVERY_INTERVAL_MINUTES=60

# How often the executioner checks for pending RSVPs (in seconds).
EXECUTIONER_INTERVAL_SECONDS=60

# --- Timezone ---
# Used by APScheduler and log timestamps. Must be a valid tz name.
TZ=Europe/Berlin
